---
/* The small sun that sits next to the site name. It is the site's mark;
   on the home page the big HeroSun takes its place. */
type Props = { class?: string };
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  aria-hidden="true"
  class:list={["sun-mark", className]}
  fill="none"
  stroke="currentColor"
  stroke-width="5"
  stroke-linecap="round"
>
  <circle cx="50" cy="50" r="19" class="fill-sun"></circle>
  <g class="rays">
    <line x1="76.7" y1="45.8" x2="89.5" y2="43.7"></line>
    <line x1="74.3" y1="61.8" x2="83.3" y2="66.2"></line>
    <line x1="67.0" y1="71.0" x2="76.4" y2="82.6"></line>
    <line x1="51.9" y1="76.9" x2="52.7" y2="87.9"></line>
    <line x1="40.3" y1="75.2" x2="35.3" y2="88.3"></line>
    <line x1="27.6" y1="65.1" x2="20.2" y2="70.1"></line>
    <line x1="23.3" y1="54.2" x2="10.5" y2="56.3"></line>
    <line x1="25.7" y1="38.2" x2="14.9" y2="32.9"></line>
    <line x1="33.0" y1="29.0" x2="23.6" y2="17.4"></line>
    <line x1="48.1" y1="23.1" x2="47.4" y2="13.1"></line>
    <line x1="59.7" y1="24.8" x2="64.3" y2="12.7"></line>
    <line x1="72.4" y1="34.9" x2="81.5" y2="28.8"></line>
  </g>
</svg>
