---
/* The small Outrun sun next to the site name: striped disc on a horizon. */
type Props = { class?: string };
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  aria-hidden="true"
  class:list={["sun-mark", className]}
  fill="none"
>
  <defs>
    <linearGradient id="sun-mark-g" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="stop-top"></stop>
      <stop offset="1" class="stop-bottom"></stop>
    </linearGradient>
    <mask id="sun-mark-m">
      <circle cx="50" cy="48" r="38" fill="#fff"></circle>
      <g fill="#000"
        ><rect x="6" y="54.0" width="88" height="2.5"></rect><rect
          x="6"
          y="61.5"
          width="88"
          height="5.0"></rect><rect x="6" y="71.5" width="88" height="7.5"
        ></rect><rect x="6" y="84.0" width="88" height="10.0"></rect></g
      >
    </mask>
    <clipPath id="sun-mark-h"
      ><rect x="0" y="0" width="100" height="84"></rect></clipPath
    >
  </defs>
  <g clip-path="url(#sun-mark-h)">
    <circle
      cx="50"
      cy="48"
      r="38"
      fill="url(#sun-mark-g)"
      mask="url(#sun-mark-m)"></circle>
  </g>
  <path d="M4 84H96" stroke="var(--sea)" stroke-width="6" stroke-linecap="round"
  ></path>
</svg>

<style>
  .stop-top {
    stop-color: var(--sun);
  }
  .stop-bottom {
    stop-color: var(--sun-low);
  }
</style>
