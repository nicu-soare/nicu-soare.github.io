---
type Entry = {
  rank: number;
  year: number;
  song: string;
  artist: string;
  plays: number;
  previousPlays: number | null;
  newPlays: number | null;
  growthPercent: number | null;
  versionCount: number;
  topTrackName: string;
  spotifyUrl: string;
  versions: Array<{
    trackId: string;
    trackName: string;
    artists: string;
    albumName: string;
    plays: number;
    source: string;
    spotifyUrl: string;
  }>;
};

const { entries, generatedAt, previousGeneratedAt, createdAt } = Astro.props as {
  entries: Entry[];
  generatedAt: string;
  previousGeneratedAt: string | null;
  createdAt: string;
};

const formatNumber = (value: number) => new Intl.NumberFormat('ro-RO').format(value);
const formatNewPlays = (value: number | null) => value === null ? '—' : `+${formatNumber(value)}`;
const formatGrowth = (value: number | null) => value === null ? '—' : `+${value.toLocaleString('ro-RO')}%`;
const years = entries.map((entry) => entry.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const missingYears = [];
for (let year = minYear; year <= maxYear; year += 1) {
  if (!years.includes(year)) missingYears.push(year);
}
---

<section class="spotify-tool" aria-labelledby="moldova-spotify-heading">
  <div class="tool-header">
    <p class="eyebrow">Moldova la Eurovision</p>
    <h1 id="moldova-spotify-heading">Topul pieselor Moldovei la Eurovision după ascultări pe Spotify</h1>
    <p class="lede">Piesele Moldovei la Eurovision, ordonate după numărul de ascultări pe Spotify.</p>
    <p class="page-dates">
      Creat: {createdAt}. Ultima actualizare a datelor: {generatedAt}
      {previousGeneratedAt ? ` · comparație cu ${previousGeneratedAt}` : ''}
    </p>
    <p class="year-range">
      Ani incluși: {minYear}-{maxYear}
      {missingYears.length > 0 && `, fără ${missingYears.join(', ')}`}
    </p>
  </div>

  <div class="table-shell">
    <table data-table>
      <thead>
        <tr>
          <th><button type="button" data-sort="rank">#</button></th>
          <th><button type="button" data-sort="song">Piesă</button></th>
          <th><button type="button" data-sort="artist">Artist</button></th>
          <th><button type="button" data-sort="year">An</button></th>
          <th><button type="button" data-sort="plays">Ascultări</button></th>
          <th><button type="button" data-sort="newPlays">Noi</button></th>
          <th><button type="button" data-sort="growthPercent">Creștere</button></th>
          <th><button type="button" data-sort="versionCount">Versiuni</button></th>
          <th>Spotify</th>
        </tr>
      </thead>
      <tbody>
        {
          entries.map((entry) => (
            <tr
              data-rank={entry.rank}
              data-song={entry.song.toLowerCase()}
              data-artist={entry.artist.toLowerCase()}
              data-year={entry.year}
              data-plays={entry.plays}
              data-new-plays={entry.newPlays ?? -1}
              data-growth-percent={entry.growthPercent ?? -1}
              data-version-count={entry.versionCount}
              data-search={`${entry.song} ${entry.artist} ${entry.year}`.toLowerCase()}
            >
              <td class="rank" data-label="#">{entry.rank}</td>
              <td class="song" data-label="Piesă">{entry.song}</td>
              <td data-label="Artist">{entry.artist}</td>
              <td class="numeric" data-label="An">{entry.year}</td>
              <td class="numeric strong" data-label="Ascultări">{formatNumber(entry.plays)}</td>
              <td class:list={['numeric', entry.newPlays !== null && 'positive']} data-label="Noi">{formatNewPlays(entry.newPlays)}</td>
              <td class:list={['numeric', entry.growthPercent !== null && 'positive']} data-label="Creștere">{formatGrowth(entry.growthPercent)}</td>
              <td data-label="Versiuni">
                <details class="versions">
                  <summary>{entry.versionCount} {entry.versionCount === 1 ? 'versiune' : 'versiuni'}</summary>
                  <ol>
                    {entry.versions.map((version) => (
                      <li>
                        <div>
                          <a href={version.spotifyUrl} target="_blank" rel="noreferrer">{version.trackName}</a>
                          <span>{version.albumName}</span>
                        </div>
                        <strong>{formatNumber(version.plays)}</strong>
                      </li>
                    ))}
                  </ol>
                </details>
              </td>
              <td data-label="Spotify">
                <a href={entry.spotifyUrl} target="_blank" rel="noreferrer">Ascultă</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  const table = document.querySelector('[data-table]');
  if (table instanceof HTMLTableElement) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);
    let sortKey = 'rank';
    let sortDirection = 1;

    const getValue = (row, key) => {
      if (key === 'versionCount') return Number(row.dataset.versionCount || 0);
      if (key === 'newPlays') return Number(row.dataset.newPlays || -1);
      if (key === 'growthPercent') return Number(row.dataset.growthPercent || -1);
      if (key === 'rank' || key === 'year' || key === 'plays') {
        return Number(row.dataset[key] || 0);
      }
      return row.dataset[key] || '';
    };

    const render = () => {
      const visibleRows = rows
        .sort((a, b) => {
          const first = getValue(a, sortKey);
          const second = getValue(b, sortKey);
          if (typeof first === 'number' && typeof second === 'number') {
            return (first - second) * sortDirection;
          }
          return String(first).localeCompare(String(second), 'ro') * sortDirection;
        });

      rows.forEach((row) => row.remove());
      visibleRows.forEach((row) => tbody.append(row));
    };

    table.querySelectorAll('[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        const nextKey = button.getAttribute('data-sort') || 'rank';
        sortDirection = nextKey === sortKey ? sortDirection * -1 : ['plays', 'newPlays', 'growthPercent'].includes(nextKey) ? -1 : 1;
        sortKey = nextKey;
        render();
      });
    });
  }
</script>

<style>
  .spotify-tool {
    width: min(68rem, 100%);
  }

  .tool-header {
    max-width: 46rem;
    margin-bottom: 1.6rem;
  }

  h1 {
    max-width: 18ch;
    margin-bottom: 1rem;
    font-size: clamp(2.4rem, 6vw, 4rem);
  }

  .lede {
    margin-bottom: 0.45rem;
    max-width: 42rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .year-range {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .page-dates {
    margin: 0 0 0.35rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .table-shell {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: white;
  }

  table {
    width: 100%;
    min-width: 70rem;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  th,
  td {
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: middle;
  }

  th {
    background: #f4f7f8;
    color: var(--muted);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  th button {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-transform: inherit;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  .rank,
  .numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .song,
  .strong {
    color: var(--text);
    font-weight: 700;
  }

  .positive {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .versions {
    min-width: 14rem;
  }

  .versions summary {
    color: var(--accent);
    cursor: pointer;
    font-weight: 700;
  }

  .versions ol {
    display: grid;
    gap: 0.7rem;
    margin: 0.8rem 0 0;
    padding-left: 1.2rem;
  }

  .versions li {
    padding-left: 0.2rem;
  }

  .versions li div {
    display: grid;
    gap: 0.1rem;
  }

  .versions li span {
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .versions li strong {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 48rem) {
    .spotify-tool {
      width: 100%;
    }

    .tool-header {
      margin-bottom: 1.2rem;
    }

    h1 {
      max-width: 15ch;
      font-size: clamp(2.15rem, 13vw, 3.1rem);
    }

    .lede {
      font-size: 1rem;
    }

    .table-shell {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    table,
    thead,
    tbody,
    tr,
    td {
      display: block;
      width: 100%;
      min-width: 0;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    tbody {
      display: grid;
      gap: 1rem;
    }

    tr {
      border: 1px solid var(--border);
      border-radius: 0.65rem;
      background: white;
      padding: 0.95rem;
    }

    td {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 0.9rem;
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      padding: 0.6rem 0;
      text-align: left;
    }

    td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    td:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .rank {
      display: inline-flex;
      width: fit-content;
      min-width: 2.15rem;
      height: 2.15rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: #eef6f5;
      color: var(--accent-strong);
      font-weight: 800;
    }

    .rank::before {
      content: none;
    }

    .song {
      grid-template-columns: 1fr;
      padding-top: 0.2rem;
      font-size: 1.25rem;
      line-height: 1.25;
    }

    .song::before {
      content: none;
    }

    .numeric {
      text-align: left;
    }

    .versions {
      min-width: 0;
    }

    .versions ol {
      padding-left: 1rem;
    }
  }
</style>
