---
type Entry = {
  rank: number;
  year: number;
  song: string;
  artist: string;
  plays: number;
  previousPlays: number | null;
  newPlays: number | null;
  growthPercent: number | null;
  recentDays: number | null;
  recentPlaysPerDay: number | null;
  recentPeriod: string | null;
  versionCount: number;
  topTrackName: string;
  spotifyUrl: string;
  versions: Array<{
    trackId: string;
    trackName: string;
    artists: string;
    albumName: string;
    plays: number;
    source: string;
    spotifyUrl: string;
  }>;
};

const { entries, pageTitle } = Astro.props as { entries: Entry[]; pageTitle: string };

const formatNumber = (value: number) => new Intl.NumberFormat('ro-RO').format(value);
const formatRecentRate = (value: number | null) => value === null || value <= 0 ? '—' : `+${formatNumber(value)}/zi`;
const years = entries.map((entry) => entry.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
const missingYears: number[] = [];
for (let year = minYear; year <= maxYear; year += 1) {
  if (!years.includes(year)) missingYears.push(year);
}
---

<section class="spotify-tool" aria-labelledby="moldova-spotify-heading">
  <div class="tool-header">
    <p class="year-range">
      Ani incluși: {minYear}-{maxYear}
      {missingYears.length > 0 && `, fără ${missingYears.join(', ')}`} (anul cand Moldova n-a participat)
    </p>
    <button
      type="button"
      class="fullscreen-toggle"
      data-fullscreen-toggle
      aria-pressed="false"
    >
      Full screen
    </button>
  </div>

  <div class="table-shell" data-table-shell>
    <div class="fullscreen-heading">
      <p class="fullscreen-kicker">Moldova la Eurovision</p>
      <h2 class="fullscreen-title">{pageTitle}</h2>
    </div>

    <table data-table>
      <colgroup>
        <col class="col-rank" />
        <col class="col-song" />
        <col class="col-artist" />
        <col class="col-year" />
        <col class="col-plays" />
        <col class="col-recent" />
        <col class="col-versions" />
        <col class="col-spotify" />
      </colgroup>
      <thead>
        <tr>
          <th><button type="button" data-sort="rank">#</button></th>
          <th><button type="button" data-sort="song">Piesă</button></th>
          <th><button type="button" data-sort="artist">Artist</button></th>
          <th><button type="button" data-sort="year">An</button></th>
          <th><button type="button" data-sort="plays">Ascultări</button></th>
          <th><button type="button" data-sort="recentPlaysPerDay">Ritm recent</button></th>
          <th><button type="button" data-sort="versionCount">Versiuni</button></th>
          <th>Spotify</th>
        </tr>
      </thead>
      <tbody>
        {
          entries.map((entry) => (
            <tr
              data-rank={entry.rank}
              data-song={entry.song.toLowerCase()}
              data-artist={entry.artist.toLowerCase()}
              data-year={entry.year}
              data-plays={entry.plays}
              data-recent-plays-per-day={entry.recentPlaysPerDay ?? -1}
              data-version-count={entry.versionCount}
              data-search={`${entry.song} ${entry.artist} ${entry.year}`.toLowerCase()}
            >
              <td class="rank" data-label="#">{entry.rank}</td>
              <td class="song" data-label="Piesă">{entry.song}</td>
              <td data-label="Artist">{entry.artist}</td>
              <td class="numeric" data-label="An">{entry.year}</td>
              <td class="numeric strong" data-label="Ascultări">{formatNumber(entry.plays)}</td>
              <td class:list={['numeric', entry.recentPlaysPerDay !== null && entry.recentPlaysPerDay > 0 && 'positive']} data-label="Ritm recent">{formatRecentRate(entry.recentPlaysPerDay)}</td>
              <td data-label="Versiuni">
                <details class="versions">
                  <summary>{entry.versionCount} {entry.versionCount === 1 ? 'versiune' : 'versiuni'}</summary>
                  <ol>
                    {entry.versions.map((version) => (
                      <li>
                        <div>
                          <a href={version.spotifyUrl} target="_blank" rel="noreferrer">{version.trackName}</a>
                          <span>{version.albumName}</span>
                        </div>
                        <strong>{formatNumber(version.plays)}</strong>
                      </li>
                    ))}
                  </ol>
                </details>
              </td>
              <td data-label="Spotify">
                <a href={entry.spotifyUrl} target="_blank" rel="noreferrer">Ascultă</a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<script>
  const table = document.querySelector('[data-table]');
  const tableShell = document.querySelector('[data-table-shell]');
  const fullscreenToggle = document.querySelector('[data-fullscreen-toggle]');
  const body = document.body;

  const setFullscreenState = (isFullscreen: boolean) => {
    if (!(tableShell instanceof HTMLElement) || !(fullscreenToggle instanceof HTMLButtonElement)) return;

    tableShell.classList.toggle('is-fullscreen', isFullscreen);
    fullscreenToggle.textContent = isFullscreen ? 'Exit full screen' : 'Full screen';
    fullscreenToggle.setAttribute('aria-pressed', String(isFullscreen));
    body.classList.toggle('table-fullscreen-open', isFullscreen);
    body.style.overflow = isFullscreen ? 'hidden' : '';
  };

  const exitFullscreen = () => setFullscreenState(false);

  if (fullscreenToggle instanceof HTMLButtonElement) {
    fullscreenToggle.addEventListener('click', () => {
      const isFullscreen = tableShell instanceof HTMLElement && tableShell.classList.contains('is-fullscreen');
      setFullscreenState(!isFullscreen);
    });
  }

  window.addEventListener('keydown', (event: KeyboardEvent) => {
    if (event.key === 'Escape') exitFullscreen();
  });

  if (table instanceof HTMLTableElement) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);
    let sortKey = 'rank';
    let sortDirection = 1;

    const getValue = (row: HTMLTableRowElement, key: string) => {
      if (key === 'versionCount') return Number(row.dataset.versionCount || 0);
      if (key === 'recentPlaysPerDay') return Number(row.dataset.recentPlaysPerDay || -1);
      if (key === 'rank' || key === 'year' || key === 'plays') {
        return Number(row.dataset[key] || 0);
      }
      return row.dataset[key] || '';
    };

    const render = () => {
      const visibleRows = rows
        .sort((a, b) => {
          const first = getValue(a, sortKey);
          const second = getValue(b, sortKey);
          if (typeof first === 'number' && typeof second === 'number') {
            return (first - second) * sortDirection;
          }
          return String(first).localeCompare(String(second), 'ro') * sortDirection;
        });

      rows.forEach((row) => row.remove());
      visibleRows.forEach((row) => tbody.append(row));
    };

    table.querySelectorAll('[data-sort]').forEach((button) => {
      button.addEventListener('click', () => {
        const nextKey = button.getAttribute('data-sort') || 'rank';
        sortDirection = nextKey === sortKey ? sortDirection * -1 : ['plays', 'recentPlaysPerDay'].includes(nextKey) ? -1 : 1;
        sortKey = nextKey;
        render();
      });
    });
  }
</script>

<style>
  .spotify-tool {
    width: 100%;
  }

  .tool-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .year-range {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.95rem;
  }

  .table-shell {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--background);
  }

  .fullscreen-toggle {
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--muted);
    color: var(--foreground);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.55rem 0.85rem;
  }

  .fullscreen-toggle:hover {
    background: var(--accent);
    color: var(--background);
  }

  .table-shell.is-fullscreen {
    position: fixed;
    inset: 1rem;
    z-index: 60;
    overflow: auto;
    padding: 0;
    border-radius: 0.75rem;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.22);
  }

  .fullscreen-heading {
    display: none;
  }

  .table-shell.is-fullscreen .fullscreen-heading {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1rem 0.85rem;
    border-bottom: 1px solid var(--border);
    background: var(--background);
  }

  .fullscreen-kicker {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .fullscreen-title {
    margin: 0;
    color: var(--foreground);
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .table-shell.is-fullscreen table {
    min-width: max(64rem, 100%);
  }

  .table-shell.is-fullscreen thead th {
    position: sticky;
    top: 4.3rem;
    z-index: 1;
  }

  table {
    width: 100%;
    min-width: 64rem;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .col-rank {
    width: 4rem;
  }

  .col-song {
    width: 18%;
  }

  .col-artist {
    width: 24%;
  }

  .col-year {
    width: 5.5rem;
  }

  .col-plays {
    width: 9.5rem;
  }

  .col-recent {
    width: 10rem;
  }

  .col-versions {
    width: 11rem;
  }

  .col-spotify {
    width: 6rem;
  }

  th,
  td {
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: middle;
  }

  th {
    background: var(--muted);
    color: var(--muted-foreground);
    font-size: 0.78rem;
    text-transform: uppercase;
  }

  th button {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-transform: inherit;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  .rank,
  .numeric {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .song,
  .strong {
    color: var(--foreground);
    font-weight: 700;
  }

  .positive {
    color: var(--accent);
    font-weight: 700;
  }

  .versions {
    min-width: 0;
  }

  .versions summary {
    color: var(--accent);
    cursor: pointer;
    font-weight: 700;
  }

  .versions[open] {
    display: block;
    padding: 0.35rem 0.55rem 0.1rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--muted);
  }

  .versions ol {
    display: grid;
    gap: 0.7rem;
    margin: 0.8rem 0 0;
    padding-left: 1.2rem;
  }

  .versions li {
    padding-left: 0.2rem;
  }

  .versions li div {
    display: grid;
    gap: 0.1rem;
  }

  .versions li span {
    color: var(--muted-foreground);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .versions li strong {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 72rem) {
    .spotify-tool {
      width: 100%;
    }

    .tool-header {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 1.2rem;
    }

    .table-shell {
      overflow: visible;
      border: 0;
      background: transparent;
    }

    table,
    thead,
    tbody,
    tr,
    td {
      display: block;
      width: 100%;
      min-width: 0;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    tbody {
      display: grid;
      gap: 1rem;
    }

    tr {
      border: 1px solid var(--border);
      border-radius: 0.65rem;
      background: var(--background);
      padding: 0.95rem;
    }

    td {
      display: grid;
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 0.9rem;
      align-items: baseline;
      border-bottom: 1px solid var(--border);
      padding: 0.6rem 0;
      text-align: left;
    }

    td::before {
      content: attr(data-label);
      color: var(--muted-foreground);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    td:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }

    .rank {
      display: inline-flex;
      width: fit-content;
      min-width: 2.15rem;
      height: 2.15rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--muted);
      color: var(--accent);
      font-weight: 800;
    }

    .rank::before {
      content: none;
    }

    .song {
      grid-template-columns: 1fr;
      padding-top: 0.2rem;
      font-size: 1.25rem;
      line-height: 1.25;
    }

    .song::before {
      content: none;
    }

    .numeric {
      text-align: left;
    }

    .versions {
      min-width: 0;
    }

    .versions ol {
      padding-left: 1rem;
    }
  }

  @media (max-width: 48rem) {
    .table-shell.is-fullscreen {
      inset: 0.5rem;
      border-radius: 0.5rem;
    }
  }
</style>
