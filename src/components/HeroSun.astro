---
/* The big sun on the home page. It rises from behind the wave once per page
   load; in dark mode it is the moon, with no sunrise. Both are one SVG,
   switched with CSS, so the theme toggle works without JS here. */
---

<div class="hero-sun" aria-hidden="true">
  <svg
    viewBox="0 0 100 100"
    fill="none"
    stroke="currentColor"
    stroke-width="3.8"
    stroke-linecap="round"
  >
    <g class="rays">
      <line x1="76.7" y1="45.8" x2="89.5" y2="43.7"></line>
      <line x1="74.3" y1="61.8" x2="83.3" y2="66.2"></line>
      <line x1="67.0" y1="71.0" x2="76.4" y2="82.6"></line>
      <line x1="51.9" y1="76.9" x2="52.7" y2="87.9"></line>
      <line x1="40.3" y1="75.2" x2="35.3" y2="88.3"></line>
      <line x1="27.6" y1="65.1" x2="20.2" y2="70.1"></line>
      <line x1="23.3" y1="54.2" x2="10.5" y2="56.3"></line>
      <line x1="25.7" y1="38.2" x2="14.9" y2="32.9"></line>
      <line x1="33.0" y1="29.0" x2="23.6" y2="17.4"></line>
      <line x1="48.1" y1="23.1" x2="47.4" y2="13.1"></line>
      <line x1="59.7" y1="24.8" x2="64.3" y2="12.7"></line>
      <line x1="72.4" y1="34.9" x2="81.5" y2="28.8"></line>
    </g>
    <circle cx="50" cy="50" r="22" class="fill-sun"></circle>
    <!-- the moon: a second disc in the sky colour bites the sun -->
    <circle
      cx="60"
      cy="42"
      r="19"
      class="moon-bite fill-background"
      stroke="none"></circle>
    <g class="stars fill-sun" stroke="none">
      <path d="M14 22l1.6 3.4 3.4 1.6-3.4 1.6L14 32l-1.6-3.4L9 27l3.4-1.6z"
      ></path>
      <path d="M86 66l1.2 2.6 2.6 1.2-2.6 1.2L86 73.6l-1.2-2.6-2.6-1.2 2.6-1.2z"
      ></path>
      <circle cx="80" cy="20" r="1.6"></circle>
      <circle cx="24" cy="70" r="1.3"></circle>
    </g>
  </svg>
</div>

<style>
  .hero-sun {
    width: 14rem;
    height: 10.5rem;
    overflow: hidden; /* the wave below cuts the bottom rays: the sun sits on the sea */
    display: flex;
    align-items: flex-start;
    justify-content: center;
    color: var(--foreground);
  }
  .hero-sun svg {
    width: 14rem;
    height: 14rem;
    animation: sunrise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes sunrise {
    from {
      transform: translateY(45%);
    }
    to {
      transform: translateY(0);
    }
  }
  .moon-bite,
  .stars {
    display: none;
  }
  :global([data-theme="dark"]) .hero-sun .rays {
    display: none;
  }
  :global([data-theme="dark"]) .hero-sun .moon-bite,
  :global([data-theme="dark"]) .hero-sun .stars {
    display: initial;
  }
  :global([data-theme="dark"]) .hero-sun svg {
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-sun svg {
      animation: none;
    }
  }
  @media (max-width: 40rem) {
    .hero-sun {
      width: 10rem;
      height: 7.5rem;
    }
    .hero-sun svg {
      width: 10rem;
      height: 10rem;
    }
  }
</style>
