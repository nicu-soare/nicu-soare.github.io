---
/* The Outrun sun on the home page: a striped disc setting behind a horizon
   with a perspective grid. It rises once per page load. Colours come from
   the theme: warm by day, neon (magenta glow, cyan grid) at night. */
---

<div class="hero-sun" aria-hidden="true">
  <svg viewBox="0 0 100 100" fill="none">
    <defs>
      <linearGradient id="hero-sun-g" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="stop-top"></stop>
        <stop offset="1" class="stop-bottom"></stop>
      </linearGradient>
      <mask id="hero-sun-m">
        <circle cx="50" cy="44" r="30" fill="#fff"></circle>
        <g fill="#000"
          ><rect x="16" y="50.0" width="68" height="1.4"></rect><rect
            x="16"
            y="54.4"
            width="68"
            height="2.8"></rect><rect x="16" y="60.2" width="68" height="4.2"
          ></rect><rect x="16" y="67.4" width="68" height="5.6"></rect><rect
            x="16"
            y="76.0"
            width="68"
            height="7.0"></rect></g
        >
      </mask>
      <clipPath id="hero-sun-h"
        ><rect x="0" y="0" width="100" height="72"></rect></clipPath
      >
    </defs>
    <circle class="halo" cx="50" cy="44" r="30"></circle>
    <g clip-path="url(#hero-sun-h)">
      <circle
        cx="50"
        cy="44"
        r="30"
        fill="url(#hero-sun-g)"
        mask="url(#hero-sun-m)"></circle>
    </g>
    <g class="grid" stroke-width="1.3"
      ><path d="M5 72L-80 100"></path><path d="M14 72L-54 100"></path><path
        d="M23 72L-28 100"></path><path d="M32 72L-2 100"></path><path
        d="M41 72L24 100"></path><path d="M50 72L50 100"></path><path
        d="M59 72L76 100"></path><path d="M68 72L102 100"></path><path
        d="M77 72L128 100"></path><path d="M86 72L154 100"></path><path
        d="M95 72L180 100"></path><path d="M32 76H68"></path><path d="M20 82H80"
      ></path><path d="M4 90H96"></path></g
    >
    <path class="horizon" d="M0 72H100" stroke-width="2.2"></path>
  </svg>
</div>

<style>
  .hero-sun {
    width: 14rem;
    height: 14rem;
    /* the horizon line sits at 72% of the box: pull the box down so that line
       lands on the section's bottom rule and the grid runs under it */
    margin-bottom: -3.9rem;
    color: var(--foreground);
  }
  .hero-sun svg {
    width: 100%;
    height: 100%;
    animation: sunrise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes sunrise {
    from {
      transform: translateY(14%);
      opacity: 0.4;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  .stop-top {
    stop-color: var(--sun);
  }
  .stop-bottom {
    stop-color: var(--sun-low);
  }
  .grid,
  .horizon {
    stroke: var(--sea);
  }
  .grid {
    opacity: 0.6;
  }
  .halo {
    fill: var(--glow);
    opacity: 0.22;
    filter: blur(7px);
    transform: scale(1.15);
    transform-origin: 50% 44%;
  }
  :global([data-theme="light"]) .hero-sun .halo {
    display: none;
  }
  :global([data-theme="light"]) .hero-sun .grid,
  :global([data-theme="light"]) .hero-sun .horizon {
    stroke: var(--foreground);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-sun svg {
      animation: none;
    }
  }
  @media (max-width: 40rem) {
    .hero-sun {
      width: 10rem;
      height: 10rem;
      margin-bottom: -2.8rem;
    }
  }
</style>
