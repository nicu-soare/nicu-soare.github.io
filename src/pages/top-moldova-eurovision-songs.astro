---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Datetime from "@/components/Datetime.astro";
import Footer from "@/components/Footer.astro";
import MoldovaSpotifyTable from "@/components/MoldovaSpotifyTable.astro";
import data from "@/data/moldova-eurovision-spotify.json";
import config from "@/config";

const createdAt = '2026-06-06';
const pageTitle = "Topul pieselor Moldovei la Eurovision (2005-2026)";
const pageDescription = "Piesele Moldovei la Eurovision, ordonate după numărul de ascultări pe Spotify.";
---

<Layout
  title={`Moldova la Eurovision după ascultări Spotify | ${config.site.title}`}
  description="Un top interactiv al pieselor Moldovei la Eurovision, ordonat după ascultări pe Spotify."
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={pageTitle} pageDesc={pageDescription} class="spotify-main">
    <div class="mb-6">
      <Datetime pubDatetime={createdAt} modDatetime={data.generatedAt} size="lg" />
    </div>

    <MoldovaSpotifyTable
      entries={data.entries}
      pageTitle={pageTitle}
      generatedAt={data.generatedAt}
      previousGeneratedAt={data.previousGeneratedAt}
      createdAt={createdAt}
    />
  </Main>
  <Footer />
</Layout>

<style>
  .spotify-main {
    max-width: 84rem;
  }

  .data-note {
    width: min(68rem, 100%);
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }
</style>
