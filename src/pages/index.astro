---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import moldovaSpotifyData from '../data/moldova-eurovision-spotify.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formatDate = (date: Date) =>
  date.toLocaleDateString('ro-RO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
const standalonePages = [
  {
    title: 'Topul pieselor Moldovei la Eurovision după ascultări pe Spotify',
    description: 'Un top interactiv al pieselor Moldovei la Eurovision, cu ascultări, creștere și versiuni Spotify.',
    href: `${base}/moldova-eurovision-spotify/`,
    createdDate: new Date('2026-06-06'),
    updatedDate: new Date(moldovaSpotifyData.generatedAt)
  }
];

const publications = [
  ...standalonePages,
  ...posts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    href: `${base}/blog/${post.id}/`,
    createdDate: post.data.createdDate,
    updatedDate: post.data.updatedDate
  }))
].sort((a, b) => b.updatedDate.valueOf() - a.updatedDate.valueOf());
---
<BaseLayout title="Nicu Soare Blog" description="Nicu Surfează Prin Internetul Din Moldova">
  <section class="intro">
    <h1>Nicu Soare</h1>
    <p>
      Nicu este activ pe internetul Moldovenesc din jurul anului 1998 și a văzut evoluția acestuia, care a trecut prin multe transformari.
    </p>
  </section>

  <section class="post-list" aria-labelledby="latest-posts">
    <h2 id="latest-posts">Ultimele publicări</h2>
    {
      publications.map((item) => (
        <article class="post-preview">
          <p class="date">
            Creat:
            <time datetime={item.createdDate.toISOString()}>{formatDate(item.createdDate)}</time>
            · Editat:
            <time datetime={item.updatedDate.toISOString()}>{formatDate(item.updatedDate)}</time>
          </p>
          <h3>
            <a href={item.href}>{item.title}</a>
          </h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </section>
</BaseLayout>
