---
const target = "/";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>Articol eliminat | Nicu Soare Blog</title>
  </head>
  <body>
    <p>
      Articolul a fost eliminat. Mergi la <a href={target}>acasa</a>.
    </p>
  </body>
</html>
