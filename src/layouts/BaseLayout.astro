---
import '../styles/global.css';

const { title = 'Nicu Soare Blog', description = 'Notițe, proiecte și eseuri.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`}>Nicu Soare Blog</a>
      <nav aria-label="Navigație principală">
        <a href={`${base}/`}>Acasă</a>
        <a href={`${base}/moldova-eurovision-spotify/`}>Eurovision</a>
        <a href={`${base}/about/`}>Despre</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
